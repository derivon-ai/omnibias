# EditorConfig -- https://editorconfig.org
# Keeps whitespace consistent across editors so diffs stay about the code.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.lean]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

# Verbatim third-party licence texts: never reformat.
[LICENSES/**]
insert_final_newline = unset
trim_trailing_whitespace = false
max_line_length = unset

[LICENSE]
insert_final_newline = unset
trim_trailing_whitespace = false
max_line_length = unset
